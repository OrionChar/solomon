---
import type { HTMLAttributes } from "astro/types";
import { calcTotalBudget, type MegaprojectBudget } from "./megaproject-budgets";
import type { SupportedLocale } from "../../../../../shared/i18n";
import { translations } from "../../i18n";
import ExternalLink from "../../../../../shared/assets/icons/external-link.svg";

interface Props extends HTMLAttributes<'div'>  {
    locale: SupportedLocale,
    megaprojectBudgets: MegaprojectBudget[];
    maxBudget: number;
}

const { megaprojectBudgets, locale, maxBudget, ...rest } = Astro.props;

const totalBudget = calcTotalBudget(megaprojectBudgets);
const freeSpace = maxBudget > totalBudget ? `${maxBudget - totalBudget}fr` : "";
const takenSpace = megaprojectBudgets
    .reduce((acc, value) => (acc += `${value.budget}fr `), "")
    .trim();
---

<div
    class={`bar-group ${rest.class}`}
    style={`grid-template-columns: ${takenSpace} ${freeSpace};`}
    {...rest}
>
    {
        megaprojectBudgets.map((megaproject, _index, array) => {
            return (
                <div class="bar">
                    {array.length > 1 ? (
                        <span class="value">${megaproject.budget}B</span>
                    ) : (
                        ""
                    )}
                    {megaproject?.legendKey ? (
                        <a
                            href={megaproject.reference ?? "#"}
                            target="_blank"
                            class="legend"
                        >
                            {translations[locale][megaproject.legendKey]}
                            <ExternalLink class="legend__icon" />
                        </a>
                    ) : (
                        ""
                    )}
                </div>
            );
        })
    }
</div>

<style>
    .bar-group {
        display: grid;
        gap: 1rem;
        grid-template-rows: 30rem;

        .bar, .legend {
            font-family: "Liberation Mono", Courier, monospace;
        }

        .bar {
            width: 100%;
            height: 100%;
            background-color: var(--accent);
            position: relative;
            font-size: 14rem;
            color: var(--bg);
            display: flex;
            justify-content: center;
            align-items: center;

            .value {
                font-weight: bold;
            }
        }
    }

    .legend {
        text-decoration: none;
        position: absolute;
        bottom: -22rem;
        left: 0;
        text-wrap-mode: nowrap;
        color: #7e7e7e;
        font-size: 14rem;
        align-self: end;

        .legend__icon {
            stroke: #7e7e7e;
            height: 16rem;
        }

        @media (hover: none) and (pointer: coarse) {
            .legend__icon {
                transform: translate(5px, 3px);
            }
        }

        /* Targets non-touch (mouse) devices */
        @media (hover: hover) and (pointer: fine) {
            .legend__icon {
                opacity: 0;
                transform: translate(5px, 13px);
                transition: ease-in-out 0.1s;
                transition-property: transform, opacity;
            }

            &:hover .legend__icon {
                transform: translate(5px, 3px);
                opacity: 1;
            }
        }
    }
</style>
