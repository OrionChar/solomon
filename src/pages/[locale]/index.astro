---
import { detectLocale } from '../../shared/i18n';

export function getStaticPaths() {
    return detectLocale()
}

const locale = Astro.params.locale ?? Astro.currentLocale;
---

<!DOCTYPE html>
<html lang={locale}>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Solomon — Table of Contents</title>
    
    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;500;600&family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;1,300;1,400&display=swap" rel="stylesheet">
    
    <!-- Tailwind -->
    <script src="https://cdn.tailwindcss.com"></script>
    
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        'bg-main': '#191919',
                        'accent': '#be9c63',
                        'text-body': '#7e7e7e',
                        'muted': '#3b3320',
                    },
                    fontFamily: {
                        'display': ['Cinzel', 'serif'],
                        'body': ['Cormorant Garamond', 'serif'],
                    }
                }
            }
        }
    </script>
    
    <style>
        body {
            background-color: #191919;
            -webkit-font-smoothing: antialiased;
        }
        
        /* Subtle grain texture */
        .grain::before {
            content: '';
            position: fixed;
            inset: 0;
            background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)'/%3E%3C/svg%3E");
            opacity: 0.03;
            pointer-events: none;
            z-index: 1;
        }
        
        /* Leader dots */
        .leader {
            flex: 1;
            border-bottom: 1px dotted #3b3320;
            margin: 0 1rem;
            opacity: 0.6;
        }
        
        /* Hover effect */
        .toc-item {
            transition: all 0.3s ease;
        }
        
        .toc-item:hover .leader {
            border-color: #be9c63;
            opacity: 1;
        }
        
        .toc-item:hover .item-title {
            color: #be9c63;
        }
        
        /* Subtle frame */
        .archive-frame {
            border: 1px solid #3b3320;
            position: relative;
        }
        
        .archive-frame::before {
            content: '';
            position: absolute;
            inset: 8px;
            border: 1px solid #3b3320;
            opacity: 0.4;
            pointer-events: none;
        }
        
        /* Corner marks */
        .corner-mark {
            width: 20px;
            height: 20px;
            border-color: #be9c63;
        }
        
        /* Fade animation */
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(8px); }
            to { opacity: 1; transform: translateY(0); }
        }
        
        .animate-in {
            animation: fadeIn 0.6s ease forwards;
            opacity: 0;
        }
        
        /* Divider */
        .divider-line {
            height: 1px;
            background: linear-gradient(90deg, transparent, #3b3320, transparent);
        }
    </style>
</head>
<body class="grain min-h-screen font-body text-text-body relative">
    
    <div class="relative z-10 min-h-screen flex flex-col">
        
        <!-- Header -->
        <header class="py-12 md:py-20 px-6">
            <div class="max-w-3xl mx-auto text-center">
                <p class="font-display text-xs tracking-[0.4em] text-muted uppercase mb-4 animate-in">
                    Table of Contents
                </p>
                <h1 class="font-display text-3xl md:text-4xl text-accent tracking-wider animate-in" style="animation-delay: 0.1s;">
                    SOLOMON
                </h1>
                <div class="divider-line mt-8 max-w-xs mx-auto animate-in" style="animation-delay: 0.2s;"></div>
            </div>
        </header>
        
        <!-- Main Content -->
        <main class="flex-1 px-6 pb-16">
            <div class="max-w-2xl mx-auto">
                
                <!-- Frame container -->
                <div class="archive-frame p-6 md:p-10 animate-in" style="animation-delay: 0.3s;">
                    
                    <!-- Corner decorations -->
                    <div class="absolute top-3 left-3 corner-mark border-t border-l opacity-60"></div>
                    <div class="absolute top-3 right-3 corner-mark border-t border-r opacity-60"></div>
                    <div class="absolute bottom-3 left-3 corner-mark border-b border-l opacity-60"></div>
                    <div class="absolute bottom-3 right-3 corner-mark border-b border-r opacity-60"></div>
                    
                    <!-- TOC List -->
                    <nav class="space-y-1">
                        
                        <!-- Section: Prologue -->
                        <div class="mb-6 animate-in" style="animation-delay: 0.35s;">
                            <span class="font-display text-[10px] tracking-[0.3em] text-muted uppercase">Prologue</span>
                        </div>
                        
                        <a href={`${locale}/the-price-of-the-war`} class="toc-item flex items-baseline py-3 group animate-in" style="animation-delay: 0.4s;">
                            <span class="font-display text-accent text-sm w-8">I</span>
                            <span class="item-title text-lg md:text-xl transition-colors">The Price of The War</span>
                            <span class="leader"></span>
                            <span class="font-display text-accent text-sm">01</span>
                        </a>
                        
                        <!-- Section Divider -->
                        <!-- <div class="py-4">
                            <div class="divider-line"></div>
                        </div> -->
                        
                        <!-- Section: Chronicles -->
                        <!-- <div class="mb-6 mt-8 animate-in" style="animation-delay: 0.45s;">
                            <span class="font-display text-[10px] tracking-[0.3em] text-muted uppercase">Chronicles</span>
                        </div> -->
                        <!-- 
                        <a href="#" class="toc-item flex items-baseline py-3 group animate-in" style="animation-delay: 0.5s;">
                            <span class="font-display text-accent text-sm w-8">II</span>
                            <span class="item-title text-lg md:text-xl transition-colors">The First Kingdom</span>
                            <span class="leader"></span>
                            <span class="font-display text-accent text-sm">07</span>
                        </a>
                        
                        <a href="#" class="toc-item flex items-baseline py-3 group animate-in" style="animation-delay: 0.55s;">
                            <span class="font-display text-accent text-sm w-8">III</span>
                            <span class="item-title text-lg md:text-xl transition-colors">Age of Silence</span>
                            <span class="leader"></span>
                            <span class="font-display text-accent text-sm">23</span>
                        </a>
                        
                        <a href="#" class="toc-item flex items-baseline py-3 group animate-in" style="animation-delay: 0.6s;">
                            <span class="font-display text-accent text-sm w-8">IV</span>
                            <span class="item-title text-lg md:text-xl transition-colors">The Forgotten War</span>
                            <span class="leader"></span>
                            <span class="font-display text-accent text-sm">41</span>
                        </a>
                        
                        <a href="#" class="toc-item flex items-baseline py-3 group animate-in" style="animation-delay: 0.65s;">
                            <span class="font-display text-accent text-sm w-8">V</span>
                            <span class="item-title text-lg md:text-xl transition-colors">Journey to the East</span>
                            <span class="leader"></span>
                            <span class="font-display text-accent text-sm">58</span>
                        </a>
                        
                        <a href="#" class="toc-item flex items-baseline py-3 group animate-in" style="animation-delay: 0.7s;">
                            <span class="font-display text-accent text-sm w-8">VI</span>
                            <span class="item-title text-lg md:text-xl transition-colors">The Merchant's Tale</span>
                            <span class="leader"></span>
                            <span class="font-display text-accent text-sm">73</span>
                        </a> -->
                        
                        <!-- Section Divider -->
                        <!-- <div class="py-4">
                            <div class="divider-line"></div>
                        </div> -->
                        
                        <!-- Section: Appendices -->
                        <!-- <div class="mb-6 mt-8 animate-in" style="animation-delay: 0.75s;">
                            <span class="font-display text-[10px] tracking-[0.3em] text-muted uppercase">Appendices</span>
                        </div>
                        
                        <a href="#" class="toc-item flex items-baseline py-3 group animate-in" style="animation-delay: 0.8s;">
                            <span class="font-display text-accent text-sm w-8">A</span>
                            <span class="item-title text-lg md:text-xl transition-colors">Genealogy of Kings</span>
                            <span class="leader"></span>
                            <span class="font-display text-accent text-sm">89</span>
                        </a>
                        
                        <a href="#" class="toc-item flex items-baseline py-3 group animate-in" style="animation-delay: 0.85s;">
                            <span class="font-display text-accent text-sm w-8">B</span>
                            <span class="item-title text-lg md:text-xl transition-colors">Ancient Maps</span>
                            <span class="leader"></span>
                            <span class="font-display text-accent text-sm">94</span>
                        </a>
                        
                        <a href="#" class="toc-item flex items-baseline py-3 group animate-in" style="animation-delay: 0.9s;">
                            <span class="font-display text-accent text-sm w-8">C</span>
                            <span class="item-title text-lg md:text-xl transition-colors">Index of Names</span>
                            <span class="leader"></span>
                            <span class="font-display text-accent text-sm">99</span>
                        </a> -->
                        
                    </nav>
                    
                </div>
                
                <!-- Footer note -->
                <div class="mt-10 text-center animate-in" style="animation-delay: 1s;">
                    <p class="text-muted text-sm italic">
                        «Nothing is true. Everything is permitted.»
                    </p>
                    <!-- <div class="mt-6 flex justify-center gap-6 text-xs font-display tracking-wider text-muted">
                        <span>XXIV Volumes</span>
                        <span class="text-accent">·</span>
                        <span>Est. MDCXLII</span>
                    </div> -->
                </div>
                
            </div>
        </main>
        
        <!-- Bottom accent -->
        <footer class="py-6 text-center">
            <div class="flex justify-center items-center gap-3 text-muted">
                <span class="w-8 h-px bg-muted/40"></span>
                <a href="http://alyosha.productions" target="_blank" rel="noopener noreferrer"><span class="font-display text-xs tracking-[0.2em]">alyosha.productions</span></a>
                <span class="w-8 h-px bg-muted/40"></span>
            </div>
        </footer>
        
    </div>
    
</body>
</html>
