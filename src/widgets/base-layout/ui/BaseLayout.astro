---
import './style.css'
import { detectLocale } from "../../../shared/i18n"

interface Props {
    title: string    
}

const {title} = Astro.props
const locale = Astro.params.locale ?? Astro.currentLocale;

export function getStaticPaths() {
    return detectLocale()
}
---

<!doctype html>
<html lang={locale}>
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>{title}</title>
        <slot name="head"></slot>
    </head>
    <body>
        <slot></slot>
    </body>
</html>
