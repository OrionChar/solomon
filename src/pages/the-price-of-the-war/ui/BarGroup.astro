---
import type { HTMLAttributes } from "astro/types";
import { calcTotalBudget, type MegaprojectBudget } from "./megaproject-budgets";

interface Props extends HTMLAttributes<'div'>  {
    megaprojectBudgets: MegaprojectBudget[];
    maxBudget: number;
}

const { megaprojectBudgets, maxBudget, ...rest } = Astro.props;

const totalBudget = calcTotalBudget(megaprojectBudgets);
const freeSpace = maxBudget > totalBudget ? `${maxBudget - totalBudget}fr` : "";
const takenSpace = megaprojectBudgets
    .reduce((acc, value) => (acc += `${value.budget}fr `), "")
    .trim();
---

<div
    class={`bar-group ${rest.class}`}
    style={`grid-template-columns: ${takenSpace} ${freeSpace};`}
    {...rest}
>
    {
        megaprojectBudgets.map((megaproject, _index, array) => {
            return (
                <div class="bar">
                    {array.length > 1 ?  <span class="value">${megaproject.budget}B</span> : ''}
                    {megaproject?.legend ? <div class="lagend">{megaproject.legend}</div> : ''}
                </div>
            )
        })
    }
</div>

<style>
    .bar-group {
        display: grid;
        gap: 1rem;
        grid-template-rows: 30rem;

        .bar, .lagend {
            font-family: "Liberation Mono", Courier, monospace;
        }

        .bar {
            width: 100%;
            height: 100%;
            background-color: var(--accent);
            position: relative;
            font-size: 14rem;
            color: var(--bg);
            display: flex;
            justify-content: center;
            align-items: center;

            .value {
                font-weight: bold;
            }
        }

        .lagend {
            position: absolute;
            bottom: -22rem;
            left: 0;
            text-wrap-mode: nowrap;
            color: #7e7e7e;
            font-size: 14rem;
            align-self: end;
        }
    }
</style>
