---
import IntroSlide from "./ui/intro-slide/IntroSlide.astro";
import ChartSlide from "./ui/chart-slide/ChartSlide.astro";
import { Font } from "astro:assets";
import { translate, detectLocale } from "../../../shared/i18n"
import {translations} from './i18n'
import BaseLayout from "../../../widgets/base-layout/ui/BaseLayout.astro";

const locale = Astro.params.locale ?? Astro.currentLocale;
const t = translate(translations, locale)

export function getStaticPaths() {
    return detectLocale()
}
---

<BaseLayout title={t('title')}>
    <Font slot="head" cssVariable="--font-segoe-script" preload />
    <Font slot="head" cssVariable="--font-beware" preload />

    <section style="width: 100%;">
        <IntroSlide title={t('title')} locale={locale} story={t('story')} />
        <ChartSlide locale={locale} />
    </section>
</BaseLayout>
