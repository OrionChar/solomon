---
import { detectLocale, TITLES } from "../../../shared/i18n";
import { getRelativeLocaleUrl } from "astro:i18n";
import { translations } from "./i18n";
import BaseLayout from "../../../widgets/base-layout/ui/BaseLayout.astro";
import ContentsTable from "./ui/ContentsTable.astro";
import Footer from "./ui/Footer.astro";
import Font from "astro/components/Font.astro";
import Solomon from "./ui/Solomon.astro";
import Epigraph from "./ui/Epigraph.astro";
import { translate } from "../../../shared/i18n";

export function getStaticPaths() {
    return detectLocale();
}

const locale = Astro.params.locale ?? Astro.currentLocale;
const t = translate(translations, locale)
const getTitle = translate(TITLES, locale)
---

<BaseLayout title="Solomon — Table of Contents">
    <Fragment slot='head'>
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link
            rel="preconnect"
            href="https://fonts.gstatic.com"
            crossorigin
        />

        <Font cssVariable="--font-cinzel" preload />
        <Font cssVariable="--font-cormorant-garamond" preload />
    </Fragment>

    <header class="header page__header">
        <Solomon />
        <Epigraph epigraph={t('epigraph')} />
        <div class="divider-line header__divider"></div>
    </header>

    <main class="main-container">
        <ContentsTable
            entries={[
                { href: getRelativeLocaleUrl(locale, 'the-price-of-the-war'), title: getTitle('thePriceOfTheWar')},
            ]}
        />
    </main>

    <Footer />
</BaseLayout>

<style>
    .header {
        text-align: center;
    }

    .divider-line {
        height: 1px;
        background: linear-gradient(90deg, transparent, #3b3320, transparent);
    }

    .header__divider {
        max-width: 320rem;
        margin: 20rem auto;
    }

    .grain::before {
        content: "";
        position: fixed;
        inset: 0;
        background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)'/%3E%3C/svg%3E");
        opacity: 0.03;
        pointer-events: none;
        z-index: 1;
    }

    .page__header {
        padding: 30rem;
    }

    .main-container {
        max-width: 600rem;
        margin-left: auto;
        margin-right: auto;
    }
</style>
